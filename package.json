{
  "name": "cura-hmis",
  "version": "0.1.0",
  "private": true,
  "description": "Cura - Hospital Management Information System (HMIS)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --parallel",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prisma:generate": "npm run prisma:generate --workspace=backend"
  },
  "devDependencies": {
    "prettier": "^3.5.2"
  },
  "engines": {
    "node": "20.x",
    "npm": ">=9.0.0"
  }
}

